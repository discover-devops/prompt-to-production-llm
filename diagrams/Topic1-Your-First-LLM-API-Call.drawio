="1"><mxGeometry x="800" y="660" width="240" height="110" as="geometry"/></mxCell><mxCell id="c15" value="SAME MODEL&lt;br&gt;in OpenAI data centre" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1120" y="640" width="420" height="150" as="geometry"/></mxCell><mxCell id="c16" value="skip the website" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="Concept: The ChatGPT website is ALSO just a program talking to the model. We will build our OWN program that talks to the same model directly. No website, no human." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c19" value="Interview Question&lt;br&gt;&lt;br&gt;Where does an LLM actually run when you use ChatGPT?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="850" width="540" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="B2 API The Waiter"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART B2: What is an API? Think of a Restaurant" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="CUSTOMER&lt;br&gt;= Our Program" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="360" height="140" as="geometry"/></mxCell><mxCell id="c5" value="WAITER&lt;br&gt;= API" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="360" height="140" as="geometry"/></mxCell><mxCell id="c6" value="KITCHEN / CHEF&lt;br&gt;= AI Model" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="380" height="140" as="geometry"/></mxCell><mxCell id="c7" value="order" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="order" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="MENU = API Documentation&lt;br&gt;What you can order and how to ask" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="720" height="130" as="geometry"/></mxCell><mxCell id="c10" value="BILL = Token usage&lt;br&gt;What you pay for every order" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="640" height="130" as="geometry"/></mxCell><mxCell id="c11" value="You NEVER walk into the kitchen.&lt;br&gt;You do not need to know how the chef cooks.&lt;br&gt;You order in a FIXED way. Food and bill come back." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1420" height="170" as="geometry"/></mxCell><mxCell id="c12" value="You already use APIs every day:&lt;br&gt;PhonePe pays your bank through an API.&lt;br&gt;Uber shows Google Maps through an API.&lt;br&gt;Swiggy takes payment through Razorpay API." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1100" height="230" as="geometry"/></mxCell><mxCell id="c13" value="Concept&lt;br&gt;API = Application Programming Interface.&lt;br&gt;A fixed, agreed way for one program to ask another program for something." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="730" width="560" height="230" as="geometry"/></mxCell><mxCell id="c14" value="Interview Question: Explain an API to a non-technical person in one line." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1700" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="B3 Why JSON"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART B3: Why Do Programs Speak JSON?" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="A HUMAN writes freely:&lt;br&gt;&lt;br&gt;Hi, I want 2 paneer butter masala, less spicy, and 1 naan please." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="200" as="geometry"/></mxCell><mxCell id="c5" value="A waiter understands.&lt;br&gt;A COMPUTER asks:&lt;br&gt;Which is the item? Which is the quantity? Where is the spice level?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="820" height="200" as="geometry"/></mxCell><mxCell id="c6" value="So programs fill a FORM instead:&lt;br&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;item&quot;: &quot;Paneer Butter Masala&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;quantity&quot;: 2,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;spice&quot;: &quot;less&quot;&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="340" as="geometry"/></mxCell><mxCell id="c7" value="How to read JSON&lt;br&gt;&lt;br&gt;{ }  one form&lt;br&gt;&quot;item&quot;  the label (key)&lt;br&gt;&quot;Paneer...&quot;  the value&lt;br&gt;2  a number, no quotes&lt;br&gt;[ ]  a list of things" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="360" width="820" height="340" as="geometry"/></mxCell><mxCell id="c8" value="Concept: Why JSON?&lt;br&gt;1. Both sides know exactly where each piece of data is.&lt;br&gt;2. Python, Java, JavaScript, every language can read it.&lt;br&gt;3. Humans can read it too." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1100" height="230" as="geometry"/></mxCell><mxCell id="c9" value="LIVE DEMO&lt;br&gt;ChatGPT website&lt;br&gt;F12 then Network tab.&lt;br&gt;Send a message.&lt;br&gt;Your message is inside JSON!" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="740" width="560" height="230" as="geometry"/></mxCell><mxCell id="c10" value="Interview Question: Why do APIs use JSON instead of plain sentences?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1700" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="B4 The Order Slip Request"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART B4: The Order Slip, What We Send to the LLM" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="WHERE to send (Endpoint)&lt;br&gt;https://api.openai.com/v1/responses" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="120" as="geometry"/></mxCell><mxCell id="c5" value="= Which restaurant&lt;br&gt;and which counter" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="640" height="120" as="geometry"/></mxCell><mxCell id="c6" value="WHO is asking (API Key)&lt;br&gt;Authorization: Bearer sk-...." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1000" height="120" as="geometry"/></mxCell><mxCell id="c7" value="= Your membership card.&lt;br&gt;Who pays the bill." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="250" width="640" height="120" as="geometry"/></mxCell><mxCell id="c8" value="WHAT we ask (JSON body)&lt;br&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;model&quot;: &quot;gpt-...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;instructions&quot;: &quot;Summarise this email in one line.&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;input&quot;: &quot;Paisa kat gaya but order nahi aaya&quot;&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1000" height="330" as="geometry"/></mxCell><mxCell id="c9" value="model = Which chef&lt;br&gt;&lt;br&gt;instructions = House rules&lt;br&gt;(system message)&lt;br&gt;&lt;br&gt;input = The actual order&lt;br&gt;(user message)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="640" height="330" as="geometry"/></mxCell><mxCell id="c10" value="Concept: API Key = your ATM PIN.&lt;br&gt;Anyone who has it can order on YOUR bill. Never share it, never put it in code, never push it to GitHub." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1100" height="170" as="geometry"/></mxCell><mxCell id="c11" value="ChatGPT Plus subscription&lt;br&gt;is NOT an API key.&lt;br&gt;API billing is separate." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="770" width="560" height="170" as="geometry"/></mxCell><mxCell id="c12" value="Interview Question: What are the parts of an LLM API request?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1700" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="B5 Food and Bill Response"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART B5: What Comes Back, the Food and the Bill" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Response (JSON)&lt;br&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;model&quot;: &quot;gpt-...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;output_text&quot;: &quot;Payment deducted, order not created.&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;usage&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;input_tokens&quot;: 42,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;output_tokens&quot;: 15&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="400" as="geometry"/></mxCell><mxCell id="c5" value="output_text&lt;br&gt;= The FOOD&lt;br&gt;(the answer)&lt;br&gt;&lt;br&gt;usage&lt;br&gt;= The BILL&lt;br&gt;(tokens used)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="640" height="400" as="geometry"/></mxCell><mxCell id="c6" value="What is a TOKEN?&lt;br&gt;&lt;br&gt;The model reads text in small pieces.&lt;br&gt;unbelievable  =  un + believ + able  (3 tokens)&lt;br&gt;About 1 token = 3/4 of an English word.&lt;br&gt;Hinglish and Hindi often use MORE tokens." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1000" height="260" as="geometry"/></mxCell><mxCell id="c7" value="Like a TAXI METER&lt;br&gt;&lt;br&gt;Pay per km = Pay per token.&lt;br&gt;What you SEND = input tokens.&lt;br&gt;What it WRITES = output tokens.&lt;br&gt;Output usually costs more." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="640" height="260" as="geometry"/></mxCell><mxCell id="c8" value="Concept: The Bill&lt;br&gt;1,000 input x $2 per million + 500 output x $8 per million = $0.006 per email.&lt;br&gt;10,000 emails a day = $60 a day = about $1,800 a month.  (teaching prices)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1700" height="150" as="geometry"/></mxCell><mxCell id="c9" value="Interview Question: Why track input and output tokens separately?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1700" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="B6 Three Restaurants"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART B6: Three Restaurants, Same Dish, Different Order Forms" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="OpenAI&lt;br&gt;Model: GPT" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Anthropic&lt;br&gt;Model: Claude" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="520" height="120" as="geometry"/></mxCell><mxCell id="c6" value="Google&lt;br&gt;Model: Gemini" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="540" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Rules go in:&lt;br&gt;instructions" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="520" height="110" as="geometry"/></mxCell><mxCell id="c8" value="Rules go in:&lt;br&gt;system" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="520" height="110" as="geometry"/></mxCell><mxCell id="c9" value="Rules go in:&lt;br&gt;system_instruction" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="260" width="540" height="110" as="geometry"/></mxCell><mxCell id="c10" value="Answer is in:&lt;br&gt;output_text" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="520" height="110" as="geometry"/></mxCell><mxCell id="c11" value="Answer is in:&lt;br&gt;content[0].text" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="520" height="110" as="geometry"/></mxCell><mxCell id="c12" value="Answer is in:&lt;br&gt;text" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="540" height="110" as="geometry"/></mxCell><mxCell id="c13" value="Bill is in:&lt;br&gt;usage.input_tokens" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="520" height="110" as="geometry"/></mxCell><mxCell id="c14" value="Bill is in:&lt;br&gt;usage.input_tokens" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="540" width="520" height="110" as="geometry"/></mxCell><mxCell id="c15" value="Bill is in:&lt;br&gt;usage_metadata&lt;br&gt;.prompt_token_count" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="540" height="110" as="geometry"/></mxCell><mxCell id="c16" value="Why use more than one?&lt;br&gt;Price. Quality. Backup when one is down.&lt;br&gt;The customer company may allow only one (FDE reality)." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c17" value="Same idea everywhere:&lt;br&gt;Send order slip.&lt;br&gt;Get food and bill." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="690" width="540" height="200" as="geometry"/></mxCell><mxCell id="c18" value="Concept: Same biryani, three restaurants, three different order forms. Our program must fill each form correctly." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1700" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="B Summary"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART B: Summary, How Our Program Talks to an LLM" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="OUR PROGRAM&lt;br&gt;fills the order slip&lt;br&gt;(JSON)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="400" height="180" as="geometry"/></mxCell><mxCell id="c5" value="API&lt;br&gt;the waiter&lt;br&gt;(endpoint + API key)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="400" height="180" as="geometry"/></mxCell><mxCell id="c6" value="LLM&lt;br&gt;the chef&lt;br&gt;(GPT / Claude / Gemini)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="400" height="180" as="geometry"/></mxCell><mxCell id="c7" value="RESPONSE&lt;br&gt;food + bill&lt;br&gt;(answer + tokens)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="400" height="180" as="geometry"/></mxCell><mxCell id="c8" value="OUR PROGRAM&lt;br&gt;reads answer,&lt;br&gt;calculates cost" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="400" height="180" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Concept: Now we know WHAT to send and WHAT comes back.&lt;br&gt;Next: Which TOOLS do we need to build this program?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1700" height="140" as="geometry"/></mxCell><mxCell id="c14" value="Interview Question&lt;br&gt;Walk me through what happens, step by step, when a Python program calls an LLM API." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1700" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="C1 Where Our Program Lives"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C1: Where Will Our Program Live? Your Laptop + VS Code" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="YOUR LAPTOP&lt;br&gt;Windows or Mac&lt;br&gt;Python installed" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="480" height="170" as="geometry"/></mxCell><mxCell id="c5" value="VS CODE&lt;br&gt;Our workspace to&lt;br&gt;write and run code" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="480" height="170" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="Free, from Microsoft.&lt;br&gt;Used by most engineers&lt;br&gt;in the world." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="500" height="170" as="geometry"/></mxCell><mxCell id="c8" value="Inside VS Code, 2 things we use:&lt;br&gt;&lt;br&gt;1. EDITOR  =  a notebook where we write the code&lt;br&gt;2. TERMINAL  =  a window where we TYPE instructions to the computer" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1700" height="200" as="geometry"/></mxCell><mxCell id="c9" value="Example in the terminal:&lt;br&gt;python --version" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F5F5F5;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="640" height="130" as="geometry"/></mxCell><mxCell id="c10" value="Means: &#x27;Computer, which Python do you have?&#x27;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="980" height="130" as="geometry"/></mxCell><mxCell id="c11" value="Concept: Our program is small. It only sends text over the internet and reads the answer. The heavy AI work happens in the provider&#x27;s data centre, not on our laptop." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c12" value="Interview Question&lt;br&gt;&lt;br&gt;Why can a normal laptop call a huge AI model?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="780" width="540" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="C2 Python"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C2: Python, the Language Our Program Speaks" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="A recipe needs a language&lt;br&gt;English, Hindi...&lt;br&gt;&lt;br&gt;A program needs a language&lt;br&gt;Python, Java, JavaScript..." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="260" as="geometry"/></mxCell><mxCell id="c5" value="Why PYTHON?&lt;br&gt;&lt;br&gt;1. Reads almost like English&lt;br&gt;2. The language of the AI world&lt;br&gt;3. OpenAI, Anthropic, Google give&lt;br&gt;Python tools FIRST" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="820" height="260" as="geometry"/></mxCell><mxCell id="c6" value="print(&quot;Hello ShopEase&quot;)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F5F5F5;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="820" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Means: show this text on the screen" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="430" width="820" height="120" as="geometry"/></mxCell><mxCell id="c8" value="Concept: Python is just the language we use to write instructions for the computer. You already met it in the bootcamp. Today we only use what you already know." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c9" value="Interview Question&lt;br&gt;&lt;br&gt;Why is Python the default language for AI applications?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="620" width="540" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="C3 SDK Library"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C3: The SDK, a Ready-Made Order App" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="WITHOUT an SDK we must write by hand:&lt;br&gt;&lt;br&gt;the address, the API key header, the JSON body,&lt;br&gt;send it, wait, read the JSON back, handle errors...&lt;br&gt;EVERY single time." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1000" height="260" as="geometry"/></mxCell><mxCell id="c5" value="Like grinding your own&lt;br&gt;masala every time&lt;br&gt;you cook dal." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="640" height="260" as="geometry"/></mxCell><mxCell id="c6" value="WITH an SDK:&lt;br&gt;&lt;br&gt;client.responses.create(model=..., input=...)&lt;br&gt;&lt;br&gt;One line. The SDK fills the order slip for us." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1000" height="260" as="geometry"/></mxCell><mxCell id="c7" value="Like ready-made&lt;br&gt;MDH masala.&lt;br&gt;Someone already&lt;br&gt;did the hard work." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="420" width="640" height="260" as="geometry"/></mxCell><mxCell id="c8" value="openai  =  SDK for GPT          anthropic  =  SDK for Claude          google-genai  =  SDK for Gemini" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1700" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Concept: LIBRARY = code someone else wrote that we reuse.&lt;br&gt;SDK (Software Development Kit) = the library a company gives you to use THEIR service." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1100" height="180" as="geometry"/></mxCell><mxCell id="c10" value="Interview Question&lt;br&gt;What is the difference between calling the API directly and using an SDK?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="840" width="540" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14" name="C4 pip and requirements"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C4: pip, the Play Store for Python" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="On your PHONE&lt;br&gt;You want WhatsApp&lt;br&gt;Play Store, Install" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="520" height="180" as="geometry"/></mxCell><mxCell id="c5" value="In PYTHON&lt;br&gt;You want the OpenAI SDK&lt;br&gt;pip install openai" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="560" height="180" as="geometry"/></mxCell><mxCell id="c6" value="same idea" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="PROBLEM: 200 students, a team of 10 engineers.&lt;br&gt;How does everyone install EXACTLY the same libraries?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1700" height="130" as="geometry"/></mxCell><mxCell id="c8" value="requirements.txt&lt;br&gt;&lt;br&gt;openai&lt;br&gt;anthropic&lt;br&gt;google-genai&lt;br&gt;python-dotenv" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F5F5F5;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="520" height="300" as="geometry"/></mxCell><mxCell id="c9" value="= The SHOPPING LIST of our project&lt;br&gt;&lt;br&gt;pip install -r requirements.txt&lt;br&gt;Install everything on the list in one go." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="540" width="1120" height="300" as="geometry"/></mxCell><mxCell id="c10" value="Concept: pip downloads libraries. requirements.txt makes sure every machine gets the same ones." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1100" height="150" as="geometry"/></mxCell><mxCell id="c11" value="Interview Question&lt;br&gt;Why do we commit requirements.txt to Git?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="880" width="540" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="C5 venv"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C5: venv, a Separate Tiffin Box for Each Project" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="PROBLEM&lt;br&gt;&lt;br&gt;Project A needs openai version 1.&lt;br&gt;Project B needs openai version 2.&lt;br&gt;Install both on the same machine and&lt;br&gt;one project BREAKS." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="330" as="geometry"/></mxCell><mxCell id="c5" value="Like putting dal, curd&lt;br&gt;and sweet in ONE box.&lt;br&gt;Everything mixes." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="820" height="330" as="geometry"/></mxCell><mxCell id="c6" value="Project A&lt;br&gt;venv A&lt;br&gt;openai v1" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="500" height="200" as="geometry"/></mxCell><mxCell id="c7" value="Project B&lt;br&gt;venv B&lt;br&gt;openai v2" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="500" height="200" as="geometry"/></mxCell><mxCell id="c8" value="Separate box each.&lt;br&gt;Nothing mixes." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="500" width="540" height="200" as="geometry"/></mxCell><mxCell id="c9" value="Concept: venv (virtual environment) = a private toolbox for ONE project. Libraries installed inside it do not touch any other project." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c10" value="Interview Question&lt;br&gt;&lt;br&gt;What problem does a virtual environment solve?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="760" width="540" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="C6 env Locker"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C6: .env, a Locker for Secrets" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="PROBLEM&lt;br&gt;&lt;br&gt;Our program needs the API key (the ATM PIN).&lt;br&gt;If we write it INSIDE the code, everyone who&lt;br&gt;sees the code can spend our money." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1000" height="260" as="geometry"/></mxCell><mxCell id="c5" value="Code gets shared,&lt;br&gt;copied, uploaded.&lt;br&gt;Secrets must NOT&lt;br&gt;travel with it." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="640" height="260" as="geometry"/></mxCell><mxCell id="c6" value="main.py (the code)&lt;br&gt;&lt;br&gt;Please read the key&lt;br&gt;from the locker" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="620" height="230" as="geometry"/></mxCell><mxCell id="c7" value=".env (the locker)&lt;br&gt;&lt;br&gt;OPENAI_API_KEY=sk-...&lt;br&gt;OPENAI_MODEL=gpt-..." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="620" height="230" as="geometry"/></mxCell><mxCell id="c8" value="reads" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="python-dotenv&lt;br&gt;opens the locker" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1480" y="430" width="260" height="230" as="geometry"/></mxCell><mxCell id="c10" value="Concept: Keys and settings live OUTSIDE the code.&lt;br&gt;Change the model or price tomorrow? Edit ONE line in .env, do not touch the code." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1100" height="190" as="geometry"/></mxCell><mxCell id="c11" value="Interview Question&lt;br&gt;Where should an API key live, and where should it NEVER live?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="720" width="540" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p17" name="C7 git and gitignore"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART C7: git and .gitignore, Save and Share Safely" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="git = saves every version of our code&lt;br&gt;GitHub = shares it with the team (and the world)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1700" height="130" as="geometry"/></mxCell><mxCell id="c5" value="DANGER&lt;br&gt;&lt;br&gt;git uploads EVERYTHING in the folder,&lt;br&gt;including the .env locker with our key.&lt;br&gt;Bots scan GitHub and steal keys&lt;br&gt;within MINUTES." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="820" height="330" as="geometry"/></mxCell><mxCell id="c6" value=".gitignore&lt;br&gt;&lt;br&gt;.env&lt;br&gt;venv/&lt;br&gt;results.csv" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F5F5F5;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="290" width="400" height="330" as="geometry"/></mxCell><mxCell id="c7" value="= &#x27;Do NOT pack&lt;br&gt;these&#x27; list" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillC