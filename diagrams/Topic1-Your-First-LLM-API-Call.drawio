<mxfile host="app.diagrams.net"><diagram id="p0" name="A1 ShopEase Support Desk"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART A1: A Day at the ShopEase Support Desk" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Priya&lt;br&gt;Support Agent&lt;br&gt;500 emails every morning" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="150" as="geometry"/></mxCell><mxCell id="c5" value="Email 1:&lt;br&gt;Laptop ordered 5 days ago.&lt;br&gt;Still not dispatched." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="400" height="160" as="geometry"/></mxCell><mxCell id="c6" value="Email 2:&lt;br&gt;Ordered a laptop bag,&lt;br&gt;got a mobile cover. Refund!" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="400" height="160" as="geometry"/></mxCell><mxCell id="c7" value="Email 3:&lt;br&gt;Bank charged, but order&lt;br&gt;page says payment failed." s