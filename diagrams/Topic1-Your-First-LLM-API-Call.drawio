y"/></mxCell><mxCell id="c4" value="YOU&lt;br&gt;type a message" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="260" height="130" as="geometry"/></mxCell><mxCell id="c5" value="ChatGPT WEBSITE&lt;br&gt;(a program in&lt;br&gt;your browser)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="340" height="170" as="geometry"/></mxCell><mxCell id="c6" value="INTERNET" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F5F5F5;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="240" height="110" as="geometry"/></mxCell><mxCell id="c7" value="OpenAI DATA CENTRE&lt;br&gt;Thousands of GPUs&lt;br&gt;The MODEL lives here" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="420" height="210" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting