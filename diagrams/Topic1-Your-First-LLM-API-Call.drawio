er;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="200" as="geometry"/></mxCell><mxCell id="c5" value="FIX 1: RULES&lt;br&gt;Matches words,&lt;br&gt;not meaning.&lt;br&gt;FAILS" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="380" height="200" as="geometry"/></mxCell><mxCell id="c6" value="FIX 2: CHATGPT&lt;br&gt;Understands!&lt;br&gt;But a human&lt;br&gt;still copy-pastes." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="380" height="200" as="geometry"/></mxCell><mxCell id="c7" value="WHAT WE NEED&lt;br&gt;A PROGRAM that&lt;br&gt;talks to the AI&lt;br&gt;directly" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="340" height="200" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c5" target="c6"