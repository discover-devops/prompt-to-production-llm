="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="905" width="760" height="90" as="geometry"/></mxCell><mxCell id="c33" value="git status" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1120" y="905" width="620" height="90" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="Concept: After EVERY step the file runs. We never write 100 lines and hope." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1700" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p21" name="D2 By Hand vs SDK"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART D Step 1 vs Step 2: By Hand vs SDK" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="BY HAND (raw_call.py)&lt;br&gt;&lt;br&gt;url = the counter&lt;br&gt;headers = API key&lt;br&gt;order_slip = JSON&lt;br&gt;requests.post(...)&lt;br&gt;dig the answer out of LONG JSON" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="400" as="geometry"/></mxCell><mxCell id="c5" value="WITH SDK (summariser.py)&lt;br&gt;&lt;br&gt;client.responses.create(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;model, instructions, input)&lt;br&gt;&lt;br&gt;response.output_text&lt;br&gt;response.usage" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="820" height="400" as="geometry"/></mxCell><mxCell id="c6" value="SAME order slip.  SAME kitchen.  SAME food and bill.&lt;br&gt;The SDK just does the boring work for us." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1700" height="140" as="geometry"/></mxCell><mxCell id="c7" value="Concept: Step 1 is what the ChatGPT website does behind the screen. We did it with no website and no human." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1100" height="170" as="geometry"/></mxCell><mxCell id="c8" value="Interview Question&lt;br&gt;Raw HTTP or SDK: when would you use which?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="740" width="540" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p22" name="D3 Two Chefs Same Shape"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PART D Step 6: Same Restaurant, Two Chefs" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Chef 1: gpt-5.4&lt;br&gt;main model" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="520" height="160" as="geometry"/></mxCell><mxCell id="c5" value="Chef 2: gpt-5.4-mini&lt;br&gt;smaller, cheaper" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="520" height="160" as="geometry"/></mxCell><mxCell id="c6" value="SAME SHAPE comes back&lt;br&gt;&lt;br&gt;summary&lt;br&gt;input_tokens&lt;br&gt;output_token