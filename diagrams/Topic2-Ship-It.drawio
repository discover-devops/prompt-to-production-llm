"c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="Empty AWS account: no default VPC. Terraform builds the door, the network, the road map, the guard and the server." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1700" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Concept: Infrastructure as Code = a recipe card for the cloud. Same card, same kitchen, every time." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1100" height="170" as="geometry"/></mxCell><mxCell id="c13" value="Interview Question&lt;br&gt;terraform plan vs terraform apply?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="840" width="540" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="T2-D2 Lab Steps"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="TOPIC 2 PART D2: The Lab, Eight Steps on the Server" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="1 Terraform builds the server" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="820" height="110" as="geometry"/></mxCell><mxCell id="c5" value="2 SSH in, install tools" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="820" height="110" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="3 venv, pip, .env" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="820" height="110" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="4 Create final project files" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="820" height="110" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="5 pytest green + first commit" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="820" height="110" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="6 Ravi&#x27;s branch: break, red, fix, merge" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="250" width="820" height="110" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="7 docker build + docker run" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="400" width="820" height="110" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="8 Wrong model, read logs, fix" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F8CECC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="550" width="820" height="110" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="Concept: Every guard from Part B, used for real on one product: tests, git, Docker, logs." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="T2-D3 Docker Volume"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="TOPIC 2 PART D3: docker run, -v and --env-file" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="SERVER folder&lt;br&gt;~/shopease-summariser/output" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="620" height="170" as="geometry"/></mxCell><mxCell id="c5" value="INSIDE THE BOX&lt;br&gt;/app/output" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="640" height="170" as="geometry"/></mxCell><mxCell id="c6" value="-v copies results out" style="edgeStyle=none;html=1;rounded=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;endArrow=classic;endSize=10;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="docker run --rm --env-file .env -v &quot;$PWD/output:/app/output&quot; shopease-summariser" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#F5F5F5;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1700" height="110" as="geometry"/></mxCell><mxCell id="c8" value="--env-file .env&lt;br&gt;hands the KEY to the box at run time.&lt;br&gt;The key is never inside the image." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="820" height="200" as="geometry"/></mxCell><mxCell id="c9" value="-v server:box&lt;br&gt;a pipe from the box to the server shelf.&lt;br&gt;results.csv survives after the box closes." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFE6CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="540" width="820" height="200" as="geometry"/></mxCell><mxCell id="c10" value="Concept: A container is a sealed tiffin box. Whatever is written inside is thrown away when it closes, unless a volume connects it." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=22;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1100" height="200" as="geometry"/></mxCell><mxCell id="c11" value="Interview Question&lt;br&gt;Why must secrets never be baked into a Docker image?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="790" width="540" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>