." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#FFF2CC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1100" height="250" as="geometry"/></mxCell><mxCell id="c11" value="Interview Question&lt;br&gt;&lt;br&gt;print() vs logging: why do production apps use logging?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#E1D5E7;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="760" width="540" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="T2-B Summary Shipping Line"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="TOPIC 2 PART B: The Shipping Line, All Four Guards Together" style="text;html=1;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=36;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Change code&lt;br&gt;on a BRANCH" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#DAE8FC;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontSize=25;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="380" height="180" as="geometry"/></mxCell><mxCell id="c5" value="pytest&lt;br&gt;TASTE TEST" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#333333;fillColor=#D5E8D4;fontFamily=Comic San